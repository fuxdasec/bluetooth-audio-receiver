<Window x:Class="BluetoothAudioReceiver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BluetoothAudioReceiver.App"
        Title="Bluetooth Audio Receiver" Height="640" Width="720"
        MinHeight="420" MinWidth="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextRenderingMode="ClearType">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="0" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="0,0,4,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Bluetooth Audio Receiver" Style="{StaticResource TitleTextStyle}" />
        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Style="{StaticResource SecondaryTextStyle}"
                   Text="{x:Static local:UiStrings.Subtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
        <TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}" />
        <TextBlock Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center">
          <Hyperlink Click="RepositoryLinkOnClick"
                     ToolTip="{x:Static local:UiStrings.RepositoryTooltip}">GitHub</Hyperlink>
        </TextBlock>
      </StackPanel>
    </Grid>

    <!-- Update banner -->
    <Border Grid.Row="1" x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,0,0,12"
            Padding="14" CornerRadius="{StaticResource CardCornerRadius}"
            Background="{DynamicResource BannerBackgroundBrush}"
            BorderBrush="{DynamicResource BannerBorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource AccentButtonStyle}"
                Content="{x:Static local:UiStrings.UpdateDownload}"
                Click="UpdateDownloadButtonOnClick" />
        <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}"
                Content="{x:Static local:UiStrings.UpdateDismiss}"
                Click="UpdateDismissButtonOnClick" />
      </Grid>
    </Border>

    <!-- Transient messages, replacing the modal dialogs -->
    <Border Grid.Row="2" x:Name="MessageBar" Visibility="Collapsed" Margin="0,0,0,12"
            Padding="14,10" CornerRadius="{StaticResource ControlCornerRadius}"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="MessageDot" Width="8" Height="8" VerticalAlignment="Center"
                 Fill="{DynamicResource StatusNeutralBrush}" />
        <TextBlock Grid.Column="1" x:Name="MessageText" Margin="12,0,0,0"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- Status -->
    <Border Grid.Row="3" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="12" Height="12" VerticalAlignment="Center"
                   Fill="{DynamicResource StatusNeutralBrush}" />
          <TextBlock x:Name="StateText" Margin="12,0,0,0" FontSize="18" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="StateDetailsText" Margin="24,6,0,0" TextWrapping="Wrap"
                   Style="{StaticResource SecondaryTextStyle}" />
        <Grid Grid.Row="2" Margin="24,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                     Style="{StaticResource SecondaryTextStyle}"
                     Text="{x:Static local:UiStrings.SourceLabel}" />
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SourceNameText" Margin="16,0,12,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" FontSize="12"
                     VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                     Text="{x:Static local:UiStrings.OutputLabel}" />
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RenderEndpointText" Margin="16,8,12,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center"
                  Style="{StaticResource SubtleButtonStyle}"
                  Content="{x:Static local:UiStrings.Refresh}"
                  Click="RefreshEndpointsButtonOnClick" />
        </Grid>
      </Grid>
    </Border>

    <!-- Source -->
    <Border Grid.Row="4" Style="{StaticResource CardStyle}">
      <StackPanel>
        <TextBlock Text="{x:Static local:UiStrings.SourceTitle}"
                   Style="{StaticResource CardTitleTextStyle}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="DevicesCombo"
                    SelectionChanged="DevicesComboOnSelectionChanged"
                    ToolTip="{x:Static local:UiStrings.SourceTooltip}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" x:Name="ConnectButton" Margin="10,0,0,0"
                  Style="{StaticResource AccentButtonStyle}"
                  Content="{x:Static local:UiStrings.Connect}"
                  Click="ConnectButtonOnClick" />
          <Button Grid.Column="2" x:Name="ReconnectButton" Margin="6,0,0,0"
                  Style="{StaticResource SubtleButtonStyle}"
                  Content="{x:Static local:UiStrings.Reconnect}"
                  Click="ReconnectButtonOnClick" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Preferences -->
    <Border Grid.Row="5" Style="{StaticResource CardStyle}">
      <StackPanel>
        <TextBlock Text="{x:Static local:UiStrings.PreferencesTitle}"
                   Style="{StaticResource CardTitleTextStyle}" />
        <CheckBox x:Name="StartWithWindowsCheck"
                  Content="{x:Static local:UiStrings.StartWithWindows}"
                  Click="StartWithWindowsCheckOnClick" />
        <CheckBox x:Name="UpdateNotificationsCheck" Margin="0,12,0,0"
                  Content="{x:Static local:UiStrings.UpdateNotifications}"
                  Click="UpdateNotificationsCheckOnClick" />
      </StackPanel>
    </Border>

     </Grid>
    </ScrollViewer>

    <!-- Diagnostics -->
    <Expander Grid.Row="1" x:Name="DiagnosticsExpander" Margin="0,4,0,0"
              Expanded="DiagnosticsExpanderOnExpanded" Collapsed="DiagnosticsExpanderOnCollapsed"
              Header="{x:Static local:UiStrings.Diagnostics}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DiagnosticsStatusText" VerticalAlignment="Center" FontSize="12"
                     TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryTextStyle}" />
          <Button Grid.Column="1" Content="{x:Static local:UiStrings.CopyDiagnostics}"
                  Click="CopyDiagnosticsButtonOnClick" />
        </Grid>
        <TextBox Grid.Row="1" x:Name="DiagnosticsText" Height="220"
                 Style="{StaticResource LogTextBoxStyle}"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
      </Grid>
    </Expander>

    <!-- Footer -->
    <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0"
            Content="{x:Static local:UiStrings.HideToTray}"
            Click="HideButtonOnClick" />
  </Grid>
</Window>
