<!--
  Dark palette. Every key here must also exist in Light.xaml: a key present in only one theme
  resolves to nothing when the user switches, and the gap is invisible until it happens.
  All text on background pairs were checked at WCAG AA, 4.5:1 for text and 3:1 for the status dots.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2A2A" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#3C3C3C" />
  <SolidColorBrush x:Key="DividerBrush" Color="#383838" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#ABABAB" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#767676" />
  <SolidColorBrush x:Key="AccentBrush" Color="#5A9FD9" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FAFE2" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A8CC4" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#101A22" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#333333" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#3D3D3D" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#2C2C2C" />
  <SolidColorBrush x:Key="StatusOkBrush" Color="#5FD068" />
  <SolidColorBrush x:Key="StatusWarningBrush" Color="#F0C05A" />
  <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF8A96" />
  <SolidColorBrush x:Key="StatusNeutralBrush" Color="#A0A0A0" />
  <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#3A3320" />
  <SolidColorBrush x:Key="BannerBorderBrush" Color="#6E5F2E" />
</ResourceDictionary>
